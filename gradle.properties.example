# Copy these entries to ~/.gradle/gradle.properties (do NOT commit secrets).

# Sonatype Central Portal user token: https://central.sonatype.com/usertoken
centralPortalUsername=your_token_username
centralPortalPassword=your_token_password

# GPG signing (export with: gpg --export-secret-keys -o ~/.gradle/oksp-maven-secret.gpg <fingerprint>)
signing.keyId=DB93D926
signing.password=your_gpg_passphrase
signing.secretKeyRingFile=C:/Users/you/.gradle/oksp-maven-secret.gpg

# Legacy aliases (still supported by build.gradle.kts)
# ossrhUsername=
# ossrhPassword=
